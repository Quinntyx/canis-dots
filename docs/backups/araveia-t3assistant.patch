--- a/restore.sh
+++ b/restore.sh
@@ -4,2 +4,2 @@
-#   1. Install EndeavourOS on the NVMe: hostname araveia, user zlare, NVIDIA
-#      driver. The docs disk (sdb1) must not be formatted.
+#   1. Install EndeavourOS and ansible-core on the NVMe: hostname araveia,
