{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "$HOME/.local/bin/cliproxyapi-key",
  "env": {
    "ANTHROPIC_BASE_URL": "http://araveia.tail985727.ts.net:8317",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5"
  },
  "model": "claude-opus-5-5",
  "availableModels": [
    "claude-opus-5-5",
    "claude-fable-5-2",
    "claude-sonnet-5-5",
    "claude-haiku-5-5"
  ],
  "enforceAvailableModels": true,
  "modelPicker": {
    "replaceBuiltInOptions": true,
    "options": [
      { "model": "claude-opus-5-5", "label": "Opus 5.5" },
      { "model": "claude-fable-5-2", "label": "Fable 5.2" },
      { "model": "claude-sonnet-5-5", "label": "Sonnet 5.5" },
      { "model": "claude-haiku-5-5", "label": "Haiku 5.5" }
    ]
  },
  "theme": "auto",
  "extraKnownMarketplaces": {
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    }
  },
  "enabledPlugins": {
    "hyperframes@hyperframes": true
  },
  "permissions": {
    "deny": [
      "Edit(**/*.env*)",
      "Write(**/*.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/guard-tools.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/timing.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
