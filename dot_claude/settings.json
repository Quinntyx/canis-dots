{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "$HOME/.local/bin/cliproxyapi-key",
  "env": {
    "ANTHROPIC_BASE_URL": "http://araveia.tail985727.ts.net:8317",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
  },
  "model": "claude-opus-5-5",
  "modelPicker": {
    "options": [
      { "model": "gpt-6.1-sol", "label": "GPT 6.1 Sol", "description": "CLIProxyAPI hub" },
      { "model": "gpt-6.1-terra", "label": "GPT 6.1 Terra", "description": "CLIProxyAPI hub" },
      { "model": "gpt-6-sol", "label": "GPT 6.0 Sol", "description": "CLIProxyAPI hub" },
      { "model": "gpt-6-luna", "label": "GPT 6.0 Luna", "description": "CLIProxyAPI hub" },
      { "model": "gpt-6-astra", "label": "GPT 6.0 Astra", "description": "CLIProxyAPI hub" },
      { "model": "gpt-5.6-sol", "label": "GPT 5.6 Sol", "description": "CLIProxyAPI hub" },
      { "model": "gpt-5.6-terra", "label": "GPT 5.6 Terra", "description": "CLIProxyAPI hub" },
      { "model": "gpt-5.6-luna", "label": "GPT 5.6 Luna", "description": "CLIProxyAPI hub" },
      { "model": "deepseek-v4.1-flash-1017", "label": "DeepSeek V4.1 Flash 1017", "description": "CLIProxyAPI hub: OpenCode Go, Mistral, OpenRouter" },
      { "model": "deepseek-v4.1-flash-1017:fast", "label": "DeepSeek V4.1 Flash 1017 Fast", "description": "CLIProxyAPI hub: Inco" },
      { "model": "muse-ember", "label": "Muse Ember", "description": "CLIProxyAPI hub: OpenRouter (Meta)" }
    ]
  },
  "theme": "auto",
  "extraKnownMarketplaces": {
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    }
  },
  "enabledPlugins": {
    "hyperframes@hyperframes": true
  },
  "permissions": {
    "deny": [
      "Edit(**/*.env*)",
      "Write(**/*.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/guard-tools.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/timing.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
