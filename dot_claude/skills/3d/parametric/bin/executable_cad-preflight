#!/usr/bin/env python3
"""Report the existing Python CAD capability without changing state."""

import json
import shutil
import subprocess
import sys


def main():
    python3 = shutil.which("python3")
    uv = shutil.which("uv")
    result = {
        "python3": python3,
        "build123d": None,
        "build123d_usable": False,
        "uv": uv,
        "alternate_route": (
            f"{uv} run --no-project --with build123d python3 <script>" if uv else None
        ),
    }
    if python3:
        probe = "import build123d; print(getattr(build123d, '__version__', 'unknown'))"
        try:
            query = subprocess.run(
                [python3, "-c", probe],
                capture_output=True,
                text=True,
                timeout=60,
                check=False,
            )
            if query.returncode == 0:
                result["build123d_usable"] = True
                result["build123d"] = query.stdout.strip() or "unknown"
            else:
                error_line = query.stderr.strip().splitlines()
                result["error"] = error_line[-1] if error_line else f"exit {query.returncode}"
        except (OSError, subprocess.TimeoutExpired) as error:
            result["error"] = str(error)
    else:
        result["error"] = "python3 is missing from PATH"
    print(json.dumps(result, indent=2))
    return 0 if result["build123d_usable"] else 2


if __name__ == "__main__":
    sys.exit(main())
