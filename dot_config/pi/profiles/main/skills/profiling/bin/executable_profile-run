#!/usr/bin/env python3
"""Capture sequential process durations and Linux waited-child resource usage."""

import argparse
import datetime
import json
import os
from pathlib import Path
import platform
import signal
import subprocess
import sys
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--label", default="capture")
    parser.add_argument("--repeat", type=int, default=1)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command or args.repeat < 1:
        parser.error("a command and positive --repeat are required")
    if not sys.platform.startswith("linux") or not hasattr(os, "wait4"):
        parser.error("Linux with os.wait4 is required")
    out = args.out.expanduser().resolve()
    try:
        out.mkdir(parents=True, exist_ok=False, mode=0o700)
    except OSError as error:
        print(f"capture setup: {error}", file=sys.stderr)
        return 2
    summary = {
        "label": args.label,
        "command": command,
        "cwd": os.getcwd(),
        "started_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "platform": platform.platform(),
        "cpu_count": os.cpu_count(),
        "scope": "launched child and descendants accounted by wait4",
        "rss_semantics": "largest process high-water RSS, not simultaneous tree RSS",
        "latency_semantics": "whole-process wall time, not application operation latency",
        "runs": [],
    }
    code = 0
    for index in range(1, args.repeat + 1):
        run = {"index": index}
        interrupted = False
        start = time.monotonic_ns()
        try:
            stdout_path = out / f"run-{index:03d}.stdout"
            stderr_path = out / f"run-{index:03d}.stderr"
            with stdout_path.open("x") as stdout, stderr_path.open("x") as stderr:
                process = subprocess.Popen(
                    command, stdout=stdout, stderr=stderr, start_new_session=True
                )
                try:
                    _, status, usage = os.wait4(process.pid, 0)
                except KeyboardInterrupt:
                    interrupted = True
                    try:
                        os.killpg(process.pid, signal.SIGINT)
                    except ProcessLookupError:
                        pass
                    _, status, usage = os.wait4(process.pid, 0)
                process.returncode = os.waitstatus_to_exitcode(status)
            run.update({
                "wall_ms": (time.monotonic_ns() - start) / 1_000_000,
                "cpu_user_ms": usage.ru_utime * 1000,
                "cpu_system_ms": usage.ru_stime * 1000,
                "peak_rss_kib": usage.ru_maxrss,
                "exit_code": process.returncode,
                "interrupted": interrupted,
                "stdout": stdout_path.name,
                "stderr": stderr_path.name,
            })
            if process.returncode:
                code = 1
            if interrupted:
                code = 130
        except OSError as error:
            run["error"] = str(error)
            code = 2
        summary["runs"].append(run)
        (out / "capture.json").write_text(json.dumps(summary, indent=2) + "\n")
        if code in (2, 130):
            break
    print(json.dumps({"capture": str(out / "capture.json"), "exit_code": code}))
    return code


if __name__ == "__main__":
    sys.exit(main())
