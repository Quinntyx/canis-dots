#!/usr/bin/env python3
"""Reconcile the current Taskwarrior Mon-Sun week into the 'managed' Google Calendar.

Taskwarrior is authoritative. Events are matched to tasks one-to-one through
the `taskUuid` extended property, so repeated runs converge without deleting
and recreating: new tasks are inserted, changed tasks are patched in place,
and events whose task disappeared are deleted.

Two task forms are synced:
- Timed tasks (`starttime`+`endtime`) become timed events at their slot.
- Date-only tasks (a `scheduled` day but no times yet) become banana-yellow,
  half-circle-prefixed all-day preview events; when the morning scheduling
  pass stages times onto the task, the same uuid key migrates the event into
  a timed slot automatically.

Work completed earlier in the week stays gray and check-marked until the
window rolls over. Events outside the window are never touched, and only the
'managed' calendar is modified.

Usage:
  gcal-sync           # reconcile the current week
  gcal-sync --auth    # one-time interactive OAuth consent (opens a browser)

Credentials:
  OAuth desktop client secret at
    $GCAL_SYNC_SECRET or ~/.config/pi/profiles/omn-assistant/config/gcal-sync/client_secret.json
  Cached token at
    ~/.config/pi/profiles/omn-assistant/config/gcal-sync/token.json

Exit codes:
  0 success, 2 not authorized, 3 some per-event operations failed,
  1 fatal error.
"""

import json
import os
import secrets
import subprocess
import sys
import threading
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from datetime import date, datetime, time as dtime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, HTTPServer
from zoneinfo import ZoneInfo

TZ = ZoneInfo("America/Chicago")
TIMEZONE_NAME = "America/Chicago"
CALENDAR_SUMMARY = "managed"
SCOPES = ["https://www.googleapis.com/auth/calendar"]
UUID_KEY = "taskUuid"

PROFILE_DIR = os.path.expanduser("~/.config/pi/profiles/omn-assistant")
CONFIG_DIR = os.path.join(PROFILE_DIR, "config", "gcal-sync")
TOKEN_PATH = os.path.join(CONFIG_DIR, "token.json")


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- OAuth ----

def _secret_path():
    env = os.environ.get("GCAL_SYNC_SECRET")
    return env or os.path.join(CONFIG_DIR, "client_secret.json")


def load_client():
    path = _secret_path()
    if not os.path.exists(path):
        die(
            f"No OAuth client secret at {path}.\n"
            "Create an OAuth Client ID (Application type: Desktop app) in\n"
            "https://console.cloud.google.com/apis/credentials with the\n"
            "Google Calendar API enabled, download its JSON, and save it there."
        )
    with open(path) as f:
        data = json.load(f)
    for key in ("installed", "web"):
        if key in data:
            c = data[key]
            return c["client_id"], c["client_secret"], c.get("redirect_uris", [])
    die("Unrecognized client-secret JSON (no 'installed'/'web' block).")


def load_token():
    if os.path.exists(TOKEN_PATH):
        with open(TOKEN_PATH) as f:
            return json.load(f)
    return None


def save_token(tok):
    os.makedirs(os.path.dirname(TOKEN_PATH), exist_ok=True)
    fd = os.open(TOKEN_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(tok, f)


def token_request(form):
    req = urllib.request.Request(
        "https://oauth2.googleapis.com/token",
        data=urllib.parse.urlencode(form).encode(),
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read())


def authorize_interactive():
    client_id, client_secret, _ = load_client()
    state = secrets.token_urlsafe(16)

    result = {}

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.urlparse(self.path)
            got = dict(urllib.parse.parse_qsl(q.query))
            if q.path != "/oauth2callback" or got.get("state") != state:
                self.send_response(400)
                self.end_headers()
                self.wfile.write(b"bad request")
                return
            result["code"] = got.get("code")
            result["error"] = got.get("error")
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"<p>Authorized. You may close this tab.</p>")

        def log_message(self, *a):
            pass

    # Loopback redirect: pick a free port and serve the OAuth callback with the
    # handler class above; the server must be constructed after Handler exists.
    srv = HTTPServer(("127.0.0.1", 0), Handler)
    port = srv.server_address[1]
    redirect_uri = f"http://127.0.0.1:{port}/oauth2callback"
    params = {
        "client_id": client_id,
        "redirect_uri": redirect_uri,
        "response_type": "code",
        "scope": " ".join(SCOPES),
        "access_type": "offline",
        "prompt": "consent",
        "state": state,
    }
    url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode(params)

    t = threading.Thread(target=srv.handle_request, daemon=True)
    t.start()
    print("Opening browser for Google authorization...")
    print(url)
    webbrowser.open(url)
    t.join(timeout=300)
    srv.server_close()
    if "code" not in result:
        die(f"Authorization failed: {result.get('error') or 'timed out'}")

    tok = token_request(
        {
            "code": result["code"],
            "client_id": client_id,
            "client_secret": client_secret,
            "redirect_uri": redirect_uri,
            "grant_type": "authorization_code",
        }
    )
    tok["obtained_at"] = datetime.now(timezone.utc).isoformat()
    save_token(tok)
    print("Token cached at", TOKEN_PATH)


def fresh_access_token(tok):
    """Return an access token, refreshing once if the cache has a refresh token."""
    expires_at = tok.get("expires_at_utc")
    if expires_at and datetime.fromisoformat(expires_at) > datetime.now(timezone.utc):
        return tok["access_token"], tok
    if "refresh_token" not in tok:
        die(
            "Cached token cannot be refreshed (missing refresh_token).\n"
            "Re-run the consent flow with: gcal-sync --auth"
        )
    client_id, client_secret, _ = load_client()
    new = token_request(
        {
            "refresh_token": tok["refresh_token"],
            "client_id": client_id,
            "client_secret": client_secret,
            "grant_type": "refresh_token",
        }
    )
    tok["access_token"] = new["access_token"]
    tok["expires_in"] = new.get("expires_in", 3600)
    tok["expires_at_utc"] = (
        datetime.now(timezone.utc) + timedelta(seconds=new.get("expires_in", 3600))
    ).isoformat()
    save_token(tok)
    return tok["access_token"], tok


class Api:
    def __init__(self):
        self.token_cache = load_token()
        if not self.token_cache:
            die(
                "Not authorized yet. Run once interactively:\n"
                "  gcal-sync --auth",
                code=2,
            )

    def access_token(self):
        _, self.token_cache = fresh_access_token(self.token_cache)
        return self.token_cache["access_token"]

    def call(self, method, path, body=None, params=None, retry_auth=True):
        qs = ("?" + urllib.parse.urlencode(params)) if params else ""
        url = f"https://www.googleapis.com/calendar/v3/{path.lstrip('/')}{qs}"
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(
            url,
            data=data,
            method=method,
            headers={
                "Authorization": f"Bearer {self.access_token()}",
                "Content-Type": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(req) as resp:
                raw = resp.read()
                return json.loads(raw) if raw else {}
        except urllib.error.HTTPError as e:
            err_body = e.read().decode(errors="replace")
            if e.code == 401 and retry_auth and "refresh_token" in self.token_cache:
                # Force refresh by dropping the cached access token.
                self.token_cache.pop("access_token", None)
                return self.call(method, path, body, params, retry_auth=False)
            die(f"Calendar API {method} {path} -> HTTP {e.code}: {err_body[:800]}")


# --------------------------------------------------------------- window ----

def week_window(now=None):
    """(start, end) datetimes covering Mon 00:00 .. next-Mon 00:00 local."""
    now = now or datetime.now(TZ)
    monday = (now - timedelta(days=now.weekday())).replace(
        hour=0, minute=0, second=0, microsecond=0
    )
    return monday, monday + timedelta(days=7)


def rfc3339(dt):
    return dt.isoformat(timespec="seconds")


def window_rfc(window):
    s, e = window
    return rfc3339(s.astimezone(timezone.utc)), rfc3339(e.astimezone(timezone.utc))


def _sort_start(row):
    """Uniform sortable start key across timed (datetime) and allday (date)."""
    start = row[1]
    if isinstance(start, datetime):
        return (start.date(), start.timetz())
    return (start, dtime(0))


# ----------------------------------------------------------------- task ----

def read_tasks():
    # Export everything except deleted: pending plus completed, so work
    # finished earlier in the week keeps its calendar event until rollover.
    out = subprocess.run(
        ["task", "rc.verbose=nothing", "status.not:deleted", "export"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        die(f"task export failed: {out.stderr.strip()}")
    return json.loads(out.stdout)


def _sched_date(sched):
    """Taskwarrior 'scheduled' export forms -> local calendar date."""
    for fmt in ("%Y-%m-%d", "%Y%m%dT%H%M%SZ"):
        try:
            return datetime.strptime(sched, fmt).date()
        except ValueError:
            continue
    try:  # RFC 3339 with offset or Z suffix
        return datetime.fromisoformat(sched.replace("Z", "+00:00")).astimezone(TZ).date()
    except ValueError:
        return None


def plan_task_event(t, window):
    """Map one task to ('timed', start, end) / ('allday', date) / ('skip', ...).

    Timed tasks carry a full slot; tasks with only a scheduled day become
    all-day preview events. Returns None for tasks outside the window.
    """
    s, e = window
    sched = t.get("scheduled")
    if not sched:
        return None
    day = _sched_date(sched)
    if day is None:
        return ("skip", t.get("id"), f"unparseable scheduled '{sched}'")
    if not (s.date() <= day < e.date()):
        return None
    st, en = t.get("starttime"), t.get("endtime")
    if not (st and en):
        return ("allday", t, day)
    try:
        start = datetime.combine(day, datetime.strptime(st, "%H:%M").time(), TZ)
        end = datetime.combine(day, datetime.strptime(en, "%H:%M").time(), TZ)
        if end < start:  # overnight wrap should not happen in staged work
            raise ValueError(f"endtime {en} precedes starttime {st}")
    except ValueError as ex:
        return ("skip", t.get("id"), str(ex))
    return ("timed", t, start, end)


def timed_in_window(tasks, window):
    """Selected rows are (task, start, end); end is None for all-day previews."""
    selected, skipped = [], []
    for t in tasks:
        plan = plan_task_event(t, window)
        if plan is None:
            continue
        if plan[0] == "skip":
            skipped.append((plan[1], plan[2]))
        elif plan[0] == "timed":
            selected.append((t, plan[2], plan[3]))
        else:
            selected.append((t, plan[2], None))
    return selected, skipped


# ---------------------------------------------------------------- sync -----

def ensure_calendar(api):
    cal_list = api.call("GET", "/users/me/calendarList", params={"minAccessRole": "owner"})
    for c in cal_list.get("items", []):
        if c.get("summary") == CALENDAR_SUMMARY:
            return c["id"]
    created = api.call("POST", "/calendars", body={
        "summary": CALENDAR_SUMMARY,
        "timeZone": TIMEZONE_NAME,
    })
    return created["id"]


def fetch_week_events(api, cal_id, window):
    """Return ({uuid: event}, [events_without_uuid]) inside the week window."""
    tmin, tmax = window_rfc(window)
    by_uuid, orphans, page = {}, [], None
    while True:
        params = {
            "timeMin": tmin,
            "timeMax": tmax,
            "singleEvents": "true",
            "showDeleted": "false",
            "maxResults": 2500,
        }
        if page:
            params["pageToken"] = page
        res = api.call("GET", f"/calendars/{cal_id}/events", params=params)
        for ev in res.get("items", []):
            u = ev.get("extendedProperties", {}).get("private", {}).get(UUID_KEY)
            if u:
                by_uuid[u] = ev
            else:
                orphans.append(ev)
        page = res.get("nextPageToken")
        if not page:
            return by_uuid, orphans


def event_body(task, start, end):
    """Event payload; `end is None` renders an all-day preview for `start`."""
    t = task
    done = t.get("status") == "completed"
    is_preview = end is None
    # completed tasks export id=0; identify them by uuid instead
    desc_lines = ([] if done else [f"ID: {t['id']}"])
    desc_lines.append(f"uuid: {t['uuid']}")
    if done:
        desc_lines.append(f"completed: {t.get('end', 'yes')}")

    if is_preview:
        bounds = {"date": start.isoformat()}
    else:
        bounds = {"dateTime": rfc3339(start), "timeZone": TIMEZONE_NAME}

    # gray for completed, red for fixed, banana yellow for unscheduled
    # previews, default otherwise
    if done:
        color = "8"
    elif is_preview:
        color = "5"
    elif "fixed" in t.get("tags", []):
        color = "11"
    else:
        color = None

    summary = t["description"]
    if done:
        summary = "\u2713 " + summary
    if is_preview:
        summary = "\u25d1 " + summary  # half circle: planned but not time-boxed

    return {
        "summary": summary,
        "description": "\n".join(desc_lines),
        "location": t.get("location"),
        "colorId": color,
        "start": bounds,
        "end": dict(bounds),
        "extendedProperties": {"private": {UUID_KEY: t["uuid"]}},
    }


def _event_bounds(ev, which):
    """Normalized ('date', 'YYYY-MM-DD') | ('dateTime', aware dt) | None."""
    raw = ev.get(which) or {}
    if "dateTime" in raw:
        dt = datetime.fromisoformat(raw["dateTime"].replace("Z", "+00:00"))
        return ("dateTime", dt)
    if "date" in raw:
        return ("date", raw["date"])
    return (None, None)


def event_differs(local_body, remote_event):
    """True when any field Taskwarrior controls changed on the remote event."""
    checks = [
        local_body.get("summary") != remote_event.get("summary"),
        (local_body.get("description") or "").strip() !=
        (remote_event.get("description") or "").strip(),
        (local_body.get("location") or None) != (remote_event.get("location") or None),
        local_body.get("colorId") != (remote_event.get("colorId") or None),
        _event_bounds(local_body, "start") != _event_bounds(remote_event, "start"),
        _event_bounds(local_body, "end") != _event_bounds(remote_event, "end"),
    ]
    return any(checks)


def reconcile(api, cal_id, selected, window):
    remote_by_uuid, orphans = fetch_week_events(api, cal_id, window)
    local_by_uuid = {t["uuid"]: (t, s, e) for t, s, e in selected}

    inserted, updated, unchanged, deleted, failed = [], [], [], [], []

    def run(method, path, body=None, label=""):
        try:
            api.call(method, path, body=body)
            return True
        except Exception as ex:
            failed.append((label, str(ex)))
            return False

    # Calendar-only leftovers in the window: no matching task anymore.
    for ev in orphans:
        if run("DELETE", f"/calendars/{cal_id}/events/{ev['id']}", label="orphan"):
            deleted.append((None, ev.get("summary", "")[:60]))

    for uuid, ev in sorted(remote_by_uuid.items(), key=lambda kv: kv[1]["id"]):
        if uuid not in local_by_uuid:
            summary = ev.get("summary", "").lstrip("\u2713\u25d1 ")
            if run("DELETE", f"/calendars/{cal_id}/events/{ev['id']}", label=uuid[:8]):
                deleted.append((None, summary[:60]))

    for uuid, (t, s, e) in local_by_uuid.items():
        body = event_body(t, s, e)
        remote = remote_by_uuid.get(uuid)
        if remote is None:
            if run("POST", f"/calendars/{cal_id}/events", body=body,
                   label=t["description"][:40]):
                inserted.append((t, s, e))
        elif event_differs(body, remote):
            patch = {k: v for k, v in body.items() if k != "extendedProperties"}
            # Google merges PATCH dicts: switching an event between all-day and
            # timed requires explicitly clearing the superseded bound keys.
            was_date = "date" in (remote.get("start") or {})
            now_date = "date" in (body.get("start") or {})
            if was_date != now_date:
                for key in ("start", "end"):
                    b = dict(patch[key])
                    if now_date:
                        b["dateTime"] = None
                        b["timeZone"] = None
                    else:
                        b["date"] = None
                    patch[key] = b
            if run("PATCH", f"/calendars/{cal_id}/events/{remote['id']}", body=patch,
                   label=t["description"][:40]):
                updated.append((t, s, e))
        else:
            unchanged.append((t, s, e))

    report = {
        "inserted": inserted, "updated": updated, "unchanged": unchanged,
        "deleted": deleted, "failed": failed,
    }

    print(f"Week window: {window[0]:%Y-%m-%d %a} .. {(window[1] - timedelta(days=1)):%Y-%m-%d %a}")
    done_count = sum(1 for t, _, _ in selected if t.get("status") == "completed")
    preview_count = sum(1 for _, _, e in selected if e is None)
    print(f"{len(selected)} scheduled task(s) in window "
          f"({done_count} completed, {preview_count} untimed previews); "
          f"+{len(inserted)} new, ~{len(updated)} updated, "
          f"={len(unchanged)} unchanged, -{len(deleted)} removed.")
    for kind, mark in (("inserted", "+"), ("updated", "~"), ("unchanged", "=")):
        for t, s, e in sorted(report[kind], key=_sort_start):
            desc = t["description"]
            if t.get("status") == "completed":
                desc = "\u2713 " + desc
            if e is None:
                desc = "\u25d1 " + desc
                span = f"{s:%m-%d} (all-day)"
            else:
                span = f"{s:%m-%d %H:%M}-{e:%H:%M}"
            print(f"  {mark} [{span}] {desc[:64]}")
    for _, desc in deleted:
        print(f"  - [{desc}]")

    return report


def main():
    if "--auth" in sys.argv[1:]:
        authorize_interactive()
        return

    window = week_window()
    tasks = read_tasks()
    selected, skipped = timed_in_window(tasks, window)

    api = Api()
    cal_id = ensure_calendar(api)

    report = reconcile(api, cal_id, selected, window)

    if skipped:
        print("Skipped (unparseable):")
        for tid, why in skipped:
            print(f"  ! [{tid}] {why}")
    for label, err in report["failed"]:
        print(f"SYNC FAILED: [{label}]: {err}", file=sys.stderr)

    if report["failed"]:
        sys.exit(3)


if __name__ == "__main__":
    main()
