{
  "mcpServers": {
    "coursework": {
      "command": "/usr/bin/python",
      "args": [
        "-B",
        "-m",
        "t3assistant",
        "--config",
        "{{ .chezmoi.homeDir }}/.config/t3assistant/config.json",
        "serve",
        "--agent"
      ],
      "cwd": "{{ .chezmoi.homeDir }}/docs/src/universal-data-management/main/adapters",
      "exposure": "deferred",
      "description": "Read assignment preparation state and update learning gaps/review dates. These service tools cannot run coordinator ticks, change submission/preparation state, or submit to an LMS. Separate browser submissions of ordinary coursework require explicit approval through the coursework workflow."
    }
  }
}
