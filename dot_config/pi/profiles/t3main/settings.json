{
  "groupToolCalls": true,
  "lastChangelogVersion": "1.3.0",
  "theme": "everforest-tui-light",
  "defaultProvider": "cliproxyapi",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "cliproxyapi/gpt-6.1-sol",
    "cliproxyapi/claude-opus-5-5",
    "cliproxyapi/claude-fable-5-2",
    "cliproxyapi/claude-sonnet-5-5",
    "cliproxyapi/claude-haiku-5-5",
    "cliproxyapi/deepseek-v4.1-flash-1017",
    "cliproxyapi/deepseek-v4.1-flash-1017:fast",
    "cliproxyapi/muse-ember"
  ],
  "packages": [
    {
      "source": "git:git.quinntyx.dev/quinntyx/pi-pycells@dev",
      "skills": [
        "-skills/pi-subagents"
      ]
    },
    "git:git.quinntyx.dev/quinntyx/pi-session-move",
    "git:git.quinntyx.dev/quinntyx/pi-web-access",
    "npm:pi-permissions",
    "git:git.quinntyx.dev/quinntyx/pi-block-find-grep",
    "git:git.quinntyx.dev/quinntyx/pi-block-inline-python",
    "git:git.quinntyx.dev/quinntyx/pi-block-rm",
    "git:git.quinntyx.dev/quinntyx/pi-setup-command",
    "git:git.quinntyx.dev/quinntyx/pi-undo-latest",
    "git:git.quinntyx.dev/quinntyx/pi-update-command",
    "git:git.quinntyx.dev/quinntyx/pi-idle-time@dev",
    "git:github.com/Quinntyx/billion-context-pi@dev",
    "git:git.quinntyx.dev/quinntyx/pi-continue@main",
    "git:git.quinntyx.dev/quinntyx/pi-codex-disconnect-retry@main"
  ],
  "hideThinkingBlock": true,
  "extensions": [
    "./extensions/delegation-policy-guard.ts"
  ],
  "compaction": {
    "reserveTokens": 0
  },
  "enableSkillCommands": true,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "hidden",
  "toolActivityParam": true,
  "toolBackground": "outlines",
  "transport": "websocket-cached",
  "fullscreenExitOutput": "resume-hint",
