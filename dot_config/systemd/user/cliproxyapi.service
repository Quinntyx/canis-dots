[Unit]
Description=CLIProxyAPI dev (tailnet-only reset-pressure routing)
ConditionHost=araveia
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/tailscale wait --timeout=60s
ExecStart=%h/.local/bin/cliproxyapi
WorkingDirectory=%h/.local/share/cliproxyapi
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
