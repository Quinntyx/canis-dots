[Unit]
Description=Idle-aware relay from comfyui-proxy.socket to the SwarmUI frontend
Requires=comfyui-proxy.socket
BindsTo=comfyui.service
After=comfyui.service

[Service]
# Swarm's status polling and generation websocket count as activity. Once no client
# connections remain for 30 min, both containers stop, releasing all VRAM.
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=30min 127.0.0.1:17801
