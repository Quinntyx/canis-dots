[Unit]
Description=Save named tmux sessions with exact Pi and nvim sessions

[Service]
Type=oneshot
UnsetEnvironment=TMUX TMUX_PANE
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/tmux-persist save
# Large restores hold the shared lock; large saves can also exceed 90 seconds.
TimeoutStartSec=infinity
UMask=0077
