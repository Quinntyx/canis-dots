#!/usr/bin/env python3
"""Taskwarrior on-exit hook: keep the 'managed' Google Calendar in step after
interactive task commands. Two triggers:

- a +managed task is marked done -> its event turns gray in place;
- a task is deleted (`task delete` / `task del`) -> its event is recolored
  in place (✗ prefix, grape) instead of being removed. The recolor itself is
  data-driven: any sync run finds status:deleted tasks in the export and
  marks their events, so this hook just fires a plain sync for promptness.
  Agent-side cleanups PURGE (never delete), leaving no record and no marker.

Taskwarrior 3.x feeds each modified task as one JSON object per stdin line in
its post-modification state. The sync runs detached so `task` never blocks on
the network.
"""

import json
import os
import subprocess
import sys

SYNC = os.path.expanduser(
    "~/.config/pi/profiles/omn-assistant/skills/gcal-sync/bin/gcal-sync"
)
LOG = os.path.expanduser("~/.local/state/gcal-sync-hook.log")


def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(msg.rstrip("\n") + "\n")
    except OSError:
        pass


def main():
    triggered = []
    for line in sys.stdin.read().splitlines():
        if not line.strip():
            continue
        try:
            t = json.loads(line)
        except ValueError:
            continue
        if not isinstance(t, dict):
            continue
        done_managed = (
            t.get("status") == "completed"
            and "managed" in (t.get("tags") or [])
        )
        deleted = t.get("status") == "deleted"
        if done_managed or deleted:
            triggered.append(t.get("uuid", "?"))

    if not triggered:
        return

    if not os.access(SYNC, os.X_OK):
        return  # this machine has no omn-assistant profile; stay silent

    with open(os.devnull, "wb") as devnull:
        subprocess.Popen(
            [SYNC], stdout=devnull, stderr=devnull,
            start_new_session=True,
        )
    log(f"triggered gcal-sync ({len(triggered)} task(s): "
        f"{', '.join(u[:8] for u in triggered)})")


if __name__ == "__main__":
    try:
        main()
    except Exception as ex:  # never break task itself
        log(f"error: {ex}")
    sys.exit(0)
