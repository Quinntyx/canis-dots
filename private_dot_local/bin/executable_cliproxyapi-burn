#!/usr/bin/env bash
set -euo pipefail
key=$(jq -er '.management_key' "$HOME/.local/share/cliproxyapi/secrets.json")
data=$(printf 'header = "Authorization: Bearer %s"\n' "$key" | curl --fail --silent --show-error --max-time 10 --config - http://127.0.0.1:8317/v8/management/observability/burn)
if [[ ${1:-} == --json ]]; then printf '%s\n' "$data"; exit; fi
printf '%s\n' "$data" | jq -r '
  def pct: if . == null then "N/A" else ((. * 100 | round) / 100 | tostring) + "%" end;
  "Inefficiency: \(.inefficiency_percent | pct)",
  "Total waste:  \(.total_waste_percent | pct)",
  "Active weeks: \(.active_weeks); completed weeks: \(.completed_weeks); estimated: \(.estimated_weeks)",
  "Output TPS: \(.output_tps); active burn-equivalent TPS: \(.active_token_tps)",
  "Forced account: \(.forced_auth // "none")"
'

printf '\nQuota remaining (percentage of the full limit):\n'
for slot in 1 2 3; do
 file="$HOME/.local/share/cliproxyapi/auths/codex-plus-$slot.json"
 [[ -f "$file" ]] || continue
 identity="codex:$(jq -er '.account_id' "$file" | tr -d '\n' | sha256sum | cut -d ' ' -f 1)"
 cap5=$(jq -r '.five_hour_cap_percent // 100' "$file")
 capw=$(jq -r '.weekly_cap_percent // 100' "$file")
 printf '%s\n' "$data" | jq -r --arg id "$identity" --arg slot "$slot" --argjson cap5 "$cap5" --argjson capw "$capw" '
  def pct: (tostring) + "%";
  def remaining($w): if ($w.used_percent | type) != "number" then "N/A" else ([100 - $w.used_percent, 0] | max | pct) end;
  def usable($w;$cap): if ($w.used_percent | type) != "number" then "N/A" else ([$cap - $w.used_percent, 0] | max | pct) end;
  .accounts[$id].windows as $w |
  "Slot \($slot): 5h \(remaining($w.five_hour)), weekly \(remaining($w.weekly))" +
  (if $cap5 < 100 or $capw < 100 then "; usable before caps: 5h \(usable($w.five_hour;$cap5)), weekly \(usable($w.weekly;$capw))" else "" end)
 '
done
