{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y", "chrome-devtools-mcp@latest",
{% if dots_browser_executable | default('') %}
        "--executable-path", {{ dots_browser_executable | to_json }},
{% endif %}
        "--no-usage-statistics", "--no-performance-crux"
      ],
      "exposure": "deferred",
      "description": "Inspect and automate a browser with Chrome DevTools: screenshots, console, network, and performance debugging."
    }
  }
}
