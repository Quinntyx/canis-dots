#!/usr/bin/env python3
"""Agent-side cleanup removal: make a task like it never existed.

Operation semantics (user-set contract, 2026-10-07):

- `task delete`  — marks the task as deleted. This is the USER's operation
  (done by them, or by the agent at their explicit request). It keeps a
  deleted record, fires the on-exit hook, and paints the Google Calendar
  event purple (✗) as a cancellation marker.
- `task purge`   — removes the task from Taskwarrior entirely. This is the
  AGENT's cleanup operation (undoing its own mistakes, dropping solver
  debris): no deleted record, no hook marker, and the next plain gcal-sync
  removes the calendar event. No trace.

Usage:
    agent-task-del <uuid> [<uuid> ...]

Purges the given tasks with hooks disabled, then runs one plain gcal-sync so
their calendar events vanish immediately.
"""
import subprocess
import sys

SYNC = "[[[ dots_home ]]]/.config/pi/profiles/omn-assistant/skills/gcal-sync/bin/gcal-sync"


def main():
    uuids = [a for a in sys.argv[1:] if not a.startswith("-")]
    if not uuids:
        print("usage: agent-task-del <uuid> [<uuid> ...]", file=sys.stderr)
        return 1
    for u in uuids:
        # hooks off: a cleanup must never look like a user deletion (no
        # marker sync). TW 3.x purge only removes deleted/completed tasks,
        # so delete first (no-op if already deleted — ignore its rc) and
        # then purge; the purge rc is the real gate (a pending task that
        # failed to delete won't purge).
        subprocess.run(
            ["task", "rc.hooks=off", "rc.confirmation=off", "rc.verbose=nothing",
             u, "delete"],
            capture_output=True, text=True,
        )
        r = subprocess.run(
            ["task", "rc.hooks=off", "rc.confirmation=off",
             "rc.verbose=nothing", u, "purge"],
            capture_output=True, text=True,
        )
        if r.returncode != 0:
            print(f"purge failed for {u}: {r.stderr.strip()}", file=sys.stderr)
            return 1
        print(f"purged {u[:8]} (gone entirely)")
    # Plain sync: removes the corresponding calendar events, no purple marker.
    r = subprocess.run([SYNC], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        if "task(s) in current state" in line:
            print(line.strip())
    return r.returncode


if __name__ == "__main__":
    sys.exit(main())
