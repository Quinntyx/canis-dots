#!/usr/bin/env bash
set -euo pipefail
umask 077
config="$HOME/.config/cliproxyapi/config.yaml"
secrets="$HOME/.local/share/cliproxyapi/secrets.json"
state="$HOME/.local/state/cliproxyapi"
binary="$HOME/.local/lib/cliproxyapi/cli-proxy-api"
[[ -x "$binary" ]] || { echo "Build the main branch with cliproxyapi-update first." >&2; exit 1; }
[[ -r "$secrets" ]] || { echo "Missing private $secrets (see ~/.config/cliproxyapi/README.md)." >&2; exit 1; }
jq -e '.management_key | type == "string" and length >= 32' "$secrets" >/dev/null
mkdir -p "$state"
chmod 700 "$state"
tmp=$(mktemp "$state/config.XXXXXX")
trap 'if [[ -n "${tmp:-}" && -f "$tmp" ]]; then trash "$tmp"; fi' EXIT
cat "$config" > "$tmp"
printf '
access:
  api-keys: []
management:
  allow-remote: true
  disable-auto-update-panel: true
  secret-key: %s
' \
  "$(jq -c '.management_key' "$secrets")" >> "$tmp"
mv "$tmp" "$state/config.yaml"
tmp=''
exec "$binary" --config "$state/config.yaml" "$@"
