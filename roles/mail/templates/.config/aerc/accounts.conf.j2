#jinja2:variable_start_string:'[[[',variable_end_string:']]]'
[utdallas]
source = notmuch://
outgoing = smtp+xoauth2://dal558183%40utdallas.edu@smtp-mail.outlook.com:587
outgoing-cred-cmd = oama access dal558183@utdallas.edu
from = "Harrison, Henry" <dal558183@utdallas.edu>
check-mail = 1m
check-mail-cmd = [[[ dots_home ]]]/.local/bin/mail-sync.sh
check-mail-timeout = 120s
query-map = [[[ dots_home ]]]/.config/aerc/query-map-utdallas
maildir-account-path = utdallas
default = inbox
enable-folders-sort = true
folders-sort = inbox,unread,routed,sent,all
folders-exclude = INBOX,Sent Items

[gmail]
