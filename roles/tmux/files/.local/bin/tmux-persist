#!/usr/bin/env python3
"""Main-server tmux-resurrect snapshots, with exact Pi/nvim restoration."""
import argparse
import base64
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "tmux"
PLUGIN = HOME / ".local/share/tmux/plugins/tmux-resurrect"
PI_ENV = ("PI_CODING_AGENT_DIR", "PI_CODING_AGENT_SESSION_DIR", "PPI_PI_DIR", "PPI_PROFILE", "PPI_PROFILE_DIR")
NVIM_ENV = ("NVIM_APPNAME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME")
SOCKET = os.environ.get("TMUX", "").split(",")[0]


def tmux(*args, check=True):
    prefix = ["tmux"] + (["-S", SOCKET] if SOCKET else ["-L", "default"])
    result = subprocess.run(prefix + list(args), capture_output=True, text=True, timeout=5)
    if check and result.returncode:
        raise RuntimeError(result.stderr.strip() or "tmux command failed")
    return result.stdout.rstrip("\n")


def is_main_server():
    """Only the default socket may share the persistent layout and metadata."""
    socket = SOCKET or tmux("display-message", "-p", "#{socket_path}", check=False)
    directory = Path(os.environ.get("TMUX_TMPDIR") or "/tmp")
    expected = directory / f"tmux-{os.getuid()}" / "default"
    return bool(socket) and Path(socket).resolve() == expected.resolve()


def option(name):
    return tmux("show-option", "-g", "-v", name, check=False)


def process_info(pid):
    try:
        stat = Path(f"/proc/{int(pid)}/stat").read_text()
        parts = stat[stat.rfind(")") + 2:].split()
        return {"parent": int(parts[1]), "group": int(parts[2]), "foreground": int(parts[5]), "start": parts[19]}
    except (OSError, ValueError, IndexError):
        return None


def active_process(data, pane_pid):
    """Reject stale metadata, PID reuse, unrelated/background processes."""
    info = process_info(data.get("pid", 0))
    if not info or info["start"] != data.get("start"):
        return False
    if info["foreground"] > 0 and info["group"] != info["foreground"]:
        return False
    pid = int(data["pid"])
    for _ in range(100):
        if pid == int(pane_pid):
            return True
        parent = process_info(pid)
        if not parent or parent["parent"] <= 1:
            return False
        pid = parent["parent"]
    return False


def encode(data):
    return base64.urlsafe_b64encode(json.dumps(data, separators=(",", ":")).encode()).decode()


def rewrite_snapshot(text, panes):
    """Filter numeric names; rebase groups whose original is disposable."""
    rows = [line.split("\t") for line in text.splitlines() if line]
    groups = {}
    for row in rows:
        if row[0] == "grouped_session":
            groups.setdefault(row[2], [row[2]]).append(row[1])
    replacements = {}
    aliases = {}
    for original, members in groups.items():
        kept = [name for name in members if not name.isascii() or not name.isdecimal()]
        if kept:
            canonical = original if original in kept else kept[0]
            replacements[original] = canonical
            for name in kept:
                aliases[name] = canonical
    named = set()
    output = []
    for row in rows:
        kind = row[0]
        if kind == "state":
            continue
        if kind == "grouped_session":
            name = row[1]
            if name not in aliases or name == aliases[name]:
                continue
            row[2] = aliases[name]
        elif kind in ("pane", "window"):
            # Lookup metadata under the live name before rebasing a group.
            original = row[1]
            row[1] = replacements.get(original, original)
            if row[1].isascii() and row[1].isdecimal():
                continue
            if kind == "pane":
                data = panes.get((original, row[2], row[5]))
                # Clear every original command, including resurrect's defaults.
                # Only our validated Pi/nvim payloads may be executed.
                row[9], row[10] = "shell", ":"
                if data:
                    row[9] = "tmux-persist"
                    row[10] = ":tmux-persist resume " + encode(data)
        else:
            continue
        named.add(row[1])
        output.append(row)
    if named:
        state = next((row for row in rows if row[0] == "state"), ["state", "", ""])
        candidate = replacements.get(state[1], state[1]) if len(state) > 1 else ""
        current = candidate if candidate in named else sorted(named)[0]
        previous = state[2] if len(state) > 2 and state[2] in named else current
        output.append(["state", current, previous])
    return "".join("\t".join(row) + "\n" for row in output)


def pane_metadata():
    # JSON options cannot contain literal tabs or newlines.
    fmt = "\t".join(("#{session_name}", "#{window_index}", "#{pane_index}", "#{pane_pid}", "#{@pi-resurrect}", "#{@nvim-resurrect}"))
    result = {}
    for line in tmux("list-panes", "-a", "-F", fmt).splitlines():
        row = line.split("\t")
        if len(row) != 6:
            continue
        for raw in row[4:]:
            try:
                data = json.loads(raw)
                if data.get("version") != 1 or data.get("kind") not in ("pi", "nvim"):
                    continue
                if active_process(data, row[3]) and Path(data["sessionFile"]).is_file():
                    result[tuple(row[:3])] = data
                    break  # A nested nvim tool must not displace its owning Pi.
            except (ValueError, KeyError, TypeError, OSError):
                continue
    return result


def filter_file(path):
    path = Path(path)
    # Rewrite before resurrect updates its `last` symlink. Runtime files never
    # enter chezmoi; umask protects session paths and launch metadata.
    value = rewrite_snapshot(path.read_text(), pane_metadata())
    temporary = path.with_name(path.name + ".filtered")
    temporary.write_text(value)
    temporary.chmod(0o600)
    temporary.replace(path)


@contextlib.contextmanager
def lock():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    identity = SOCKET or tmux("display-message", "-p", "#{socket_path}", check=False) or "default"
    suffix = hashlib.sha256(identity.encode()).hexdigest()[:12]
    with (STATE / f"persist-{suffix}.lock").open("a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def server_pid():
    return tmux("display-message", "-p", "#{pid}", check=False)


def ready(pid):
    return bool(pid) and option("@tmux-persist-ready") == pid


def snapshot():
    directory = option("@resurrect-dir")
    return Path(os.path.expandvars(os.path.expanduser(directory))) / "last" if directory else None


def cleanup_resurrect(process):
    """Reap the owned process group, including resurrect's background spinner."""
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        process.wait()
        return
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        process.poll()  # Reap the leader even while descendants are exiting.
        try:
            os.killpg(process.pid, 0)
        except ProcessLookupError:
            break
        time.sleep(0.05)
    else:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(process.pid, signal.SIGKILL)
    process.wait()


def resurrect(action):
    script = PLUGIN / "scripts" / f"{action}.sh"
    if not script.is_file():
        raise RuntimeError(f"Missing tmux-resurrect: {script}; run chezmoi apply")
    # Layout size and shell startup determine runtime; a fixed deadline can leave
    # a partially restored server. Never time out a restore or a snapshot save.
    process = subprocess.Popen(["bash", str(script), "quiet"], start_new_session=True)
    try:
        result = process.wait()
    finally:
        # Also runs on cancellation, errors, and a successful script that forgot
        # to stop its spinner. Restored panes belong to tmux, not this group.
        cleanup_resurrect(process)
    if result:
        raise RuntimeError(f"tmux-resurrect {action} failed ({result})")


def restore_snapshot():
    saved = snapshot()
    if not saved or not saved.is_file():
        return
    expected = set()
    for line in saved.read_text().splitlines():
        row = line.split("\t")
        if row[0] == "pane":
            if len(row) != 11:
                raise RuntimeError(f"Malformed pane row in {saved}")
            expected.add((row[1], row[2], row[5]))
    if not expected:
        return
    resurrect("restore")
    # Upstream's shell script can exit zero after individual tmux commands fail.
    # Do not let a partial layout overwrite the complete last-good snapshot.
    actual = {tuple(line.split("\t")) for line in tmux(
        "list-panes", "-a", "-F", "#{session_name}\t#{window_index}\t#{pane_index}"
    ).splitlines()}
    missing = expected - actual
    if missing:
        raise RuntimeError(f"Restore incomplete: {len(missing)} of {len(expected)} saved panes missing; snapshot preserved")


def restore_locked(pid):
    tmux("set-option", "-g", "-u", "@tmux-persist-ready", check=False)
    tmux("set-option", "-g", "@tmux-persist-state", "restoring")
    tmux("set-option", "-g", "-u", "@tmux-persist-error", check=False)
    try:
        restore_snapshot()
        if server_pid() != pid:
            raise RuntimeError("Tmux server changed during restore")
        tmux("set-option", "-g", "@tmux-persist-ready", pid)
        tmux("set-option", "-g", "@tmux-persist-state", "ready")
    except BaseException as error:
        tmux("set-option", "-g", "-u", "@tmux-persist-ready", check=False)
        tmux("set-option", "-g", "@tmux-persist-state", "restore-failed", check=False)
        tmux("set-option", "-g", "@tmux-persist-error", str(error)[:500], check=False)
        tmux("display-message", f"Tmux restore failed: {error}; autosave paused", check=False)
        raise


def startup():
    # run-shell -b may start before tmux has created its first session.
    for _ in range(50):
        if tmux("list-sessions", check=False):
            break
        time.sleep(0.1)
    else:
        return
    with lock():
        pid = server_pid()
        if ready(pid):  # Re-sourcing config must not resurrect closed sessions.
            return
        restore_locked(pid)


def save(manual=False):
    if not tmux("list-sessions", check=False):
        return  # Never start a tmux server just to save.
    with lock():
        pid = server_pid()
        if not ready(pid):
            raise RuntimeError("Autosave paused: restore has not completed; run tmux-persist restore")
        resurrect("save")
        if manual:
            tmux("display-message", "Named tmux sessions saved (Pi/nvim only)", check=False)


def restore():
    with lock():
        pid = server_pid()
        if not pid:
            raise RuntimeError("No running tmux server to restore")
        restore_locked(pid)


def resume(payload):
    data = json.loads(base64.urlsafe_b64decode(payload))
    kind = data.get("kind")
    if data.get("version") != 1 or kind not in ("pi", "nvim"):
        raise RuntimeError("Unsupported saved process (only Pi and nvim are restored)")
    path = Path(data["sessionFile"])
    if not path.is_absolute() or not path.is_file():
        raise RuntimeError(f"Saved {kind} session is missing: {path}")
    env = os.environ.copy()
    keys = PI_ENV if kind == "pi" else NVIM_ENV
    for key in keys:
        env.pop(key, None)
    for key, value in data.get("environment", {}).items():
        if key in keys and isinstance(value, str):
            env[key] = value
    if kind == "pi":
        # Use the exact installed Pi executable, with --session rather than
        # --continue. Node's absolute path also survives login-shell PATH changes.
        argv = [data["executable"], data["entrypoint"], "--session", str(path)]
    else:
        env.pop("NVIM", None)
        env.pop("NVIM_LISTEN_ADDRESS", None)
        argv = [data.get("executable") or shutil.which("nvim") or "nvim", "-S", str(path)]
    os.chdir(data["cwd"])
    os.execvpe(argv[0], argv, env)


def interrupted(signum, frame):
    raise InterruptedError(f"Interrupted by {signal.Signals(signum).name}")


def main():
    os.umask(0o077)
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, interrupted)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("startup", "save", "restore", "filter", "resume", "is-main-server"))
    parser.add_argument("value", nargs="?")
    parser.add_argument("--manual", action="store_true")
    args = parser.parse_args()
    try:
        if args.action == "is-main-server":
            return 0 if is_main_server() else 1
        if not is_main_server():
            return 0  # Private/test servers must never read or write shared snapshots.
        if args.action == "filter":
            filter_file(args.value)
        elif args.action == "resume":
            resume(args.value)
        elif args.action == "save":
            save(args.manual)
        else:
            globals()[args.action]()
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"tmux-persist: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
