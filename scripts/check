#!/usr/bin/env python3
"""Bounded native-Ansible source/disposable checks. Never deploy to a live host."""
import ast
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
surface = sys.argv[1] if len(sys.argv) == 2 else 'all'
if surface not in ['static', 'deployment', 'software', 'tmux', 'all']:
    sys.exit('Usage: scripts/check [static|deployment|software|tmux|all]')
commands = {
    'static': [
        ['ansible-playbook', 'playbooks/site.yml', '--syntax-check'],
        [sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_source.py', '-v'],
        ['node', '--test', 'roles/agents/files/common/0644/.claude/hooks/guard-tools.test.cjs',
         'roles/agents/files/common/0644/.claude/hooks/timing.test.cjs'],
        ['git', 'diff', '--check'],
    ],
    'deployment': [
        [sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_plain_ansible.py', '-v'],
        [sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_review_regressions.py', '-v'],
        [sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_full_configuration.py', '-v'],
    ],
    'software': [[sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_fresh_software.py', '-v']],
    'tmux': [[sys.executable, '-m', 'unittest', 'discover', '-s', 'docs/host/tests', '-v']],
}
if surface in ['static', 'all']:
    for directory in ['scripts', 'tests', 'docs/host']:
        for path in (ROOT / directory).rglob('*'):
            if path.is_file() and (path.suffix == '.py' or path.name in ['check-packages', 'check']):
                ast.parse(path.read_text(), filename=str(path))
for name in commands if surface == 'all' else [surface]:
    for command in commands[name]:
        print('+', ' '.join(command), flush=True)
        result = subprocess.run(command, cwd=ROOT)
        if result.returncode:
            sys.exit(result.returncode)
