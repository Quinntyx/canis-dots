#!/usr/bin/env python3
"""Compose bounded source/disposable-home checks. Never deploy to a live host."""
import ast
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
surface = sys.argv[1] if len(sys.argv) == 2 else 'all'
if surface not in ['static', 'deployment', 'software', 'tmux', 'all']:
    sys.exit('Usage: scripts/check [static|deployment|software|tmux|all]')
commands = {
    'static': [
        ['ansible-playbook', 'playbooks/site.yml', '--syntax-check'],
        ['ansible-playbook', 'playbooks/rollback.yml', '--syntax-check'],
        [sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_migration.py', '-v'],
        ['node', '--test', 'tests/agent-guidance.test.cjs'],
        ['git', 'diff', '--check'],
    ],
    'deployment': [[sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_deployment.py', '-v'],
                   [sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_security.py', '-v']],
    'software': [[sys.executable, 'roles/software/tests/test_software.py']],
    'tmux': [[sys.executable, '-m', 'unittest', 'discover', '-s', 'docs/host/tests', '-v']],
}
if surface in ['static', 'all']:
    for directory in ['scripts', 'plugins']:
        for path in (ROOT / directory).rglob('*'):
            if path.is_file() and (path.suffix == '.py' or path.name in ['dots-source', 'check-packages', 'check']):
                ast.parse(path.read_text(), filename=str(path))
for name in commands if surface == 'all' else [surface]:
    for command in commands[name]:
        print('+', ' '.join(command), flush=True)
        result = subprocess.run(command, cwd=ROOT)
        if result.returncode:
            sys.exit(result.returncode)
